{%- assign checkout_label = label | default: 'BUY NOW' -%}
<span class="pr-buy-now">
  <span class="pr-buy-now__row">
    <span class="pr-buy-now__label">{{ checkout_label }}</span>
    <img
      class="pr-buy-now__upi"
      src="{{ 'upi_options.svg' | asset_url }}"
      alt=""
      width="56"
      height="22"
      aria-hidden="true"
    >
    {%- if show_arrow != false -%}
      <span class="pr-buy-now__arrow" aria-hidden="true">
        <svg viewBox="0 0 10 16" width="10" height="16" fill="none" focusable="false" aria-hidden="true">
          <path d="M2 2 8 8 2 14" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="miter" stroke-miterlimit="10"/>
        </svg>
      </span>
    {%- endif -%}
  </span>
  <span class="pr-buy-now__powered" aria-hidden="true">
    <span class="pr-buy-now__powered-by">Powered By</span>
    <img
      class="pr-buy-now__sr-mark"
      src="{{ 'shiprocket_logo.png' | asset_url }}"
      alt=""
      width="16"
      height="16"
      aria-hidden="true"
    >
    <span class="pr-buy-now__powered-brand">Shiprocket</span>
  </span>
</span>
