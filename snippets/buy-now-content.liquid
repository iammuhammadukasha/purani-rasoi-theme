<span class="pr-buy-now">
  <span class="pr-buy-now__row">
    <span class="pr-buy-now__label">BUY NOW</span>
    <img
      class="pr-buy-now__upi"
      src="{{ 'upi_options.svg' | asset_url }}"
      alt=""
      width="56"
      height="22"
      aria-hidden="true"
    >
    <span class="pr-buy-now__arrow" aria-hidden="true">
      <svg viewBox="0 0 11 17" width="11" height="17" focusable="false" aria-hidden="true">
        <path d="M1.75 1.75 8.25 8.5 1.75 15.25" stroke="currentColor" stroke-width="2.75" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </span>
  </span>
  <span class="pr-buy-now__powered" aria-hidden="true">
    <span class="pr-buy-now__powered-by">Powered By</span>
    <img
      class="pr-buy-now__sr-mark"
      src="{{ 'shiprocket_logo.png' | asset_url }}"
      alt=""
      width="16"
      height="16"
      aria-hidden="true"
    >
    <span class="pr-buy-now__powered-brand">Shiprocket</span>
  </span>
</span>
