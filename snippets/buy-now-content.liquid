<span class="pr-buy-now">
  <span class="pr-buy-now__row">
    <span class="pr-buy-now__label">BUY NOW</span>
    <img
      class="pr-buy-now__upi"
      src="{{ 'upi_options.svg' | asset_url }}"
      alt=""
      width="56"
      height="22"
      aria-hidden="true"
    >
    <span class="pr-buy-now__arrow" aria-hidden="true">
      <svg viewBox="0 0 11 17" width="11" height="17" focusable="false" aria-hidden="true">
        <path d="M1.75 1.75 8.25 8.5 1.75 15.25" stroke="currentColor" stroke-width="2.75" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </span>
  </span>
  <span class="pr-buy-now__powered" aria-hidden="true">
    <span class="pr-buy-now__powered-by">Powered By</span>
    <span class="pr-buy-now__sr-mark" aria-hidden="true">
      <svg viewBox="0 0 18 18" width="16" height="16" focusable="false" aria-hidden="true">
        <path d="M2.4 6.2 9 2.6 15.6 6.2v5.6L9 15.4 2.4 11.8V6.2Z" stroke="currentColor" stroke-width="1.35" stroke-linejoin="round" fill="none"/>
        <path d="M3.8 6.9 9 4.1 14.2 6.9v4.2L9 13.9 3.8 11.1V6.9Z" stroke="currentColor" stroke-width="1.2" stroke-linejoin="round" fill="none" opacity="0.95"/>
        <path d="M6.1 7.1 11.4 9 6.1 10.9V7.1Z" fill="#5e6f36" stroke="#5e6f36" stroke-width="0.2" stroke-linejoin="round"/>
      </svg>
    </span>
    <span class="pr-buy-now__powered-brand">Shiprocket</span>
  </span>
</span>
