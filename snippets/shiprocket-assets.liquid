{%- comment -%}
  Shiprocket / Fastrr headless Buy Now assets.
  Mount points: .shiprocket-headless[data-type="product|cart|mini-cart"]
{%- endcomment -%}
<script>
  function getUserTimezone() {
    return Intl.DateTimeFormat().resolvedOptions().timeZone;
  }
  function renderShiprocketButton(showShiprocketCheckout) {
    var modifiedCSS = showShiprocketCheckout
      ? 'button[name="checkout"]{display:none !important;}.pdp-buy{display:none !important;}.shopify-payment-button__button.shopify-payment-button__button--unbranded{display:none !important;}'
      : '.shiprocket-headless{display:none !important;}';
    var styleElement = document.createElement('style');
    styleElement.setAttribute('data-pr-shiprocket-tz', '');
    styleElement.textContent = modifiedCSS;
    document.head.appendChild(styleElement);
  }
  (function checkAndSetButtonVisibility() {
    var indiaTimezones = ['Asia/Kolkata', 'Asia/Calcutta'];
    renderShiprocketButton(indiaTimezones.indexOf(getUserTimezone()) !== -1);
  })();
</script>
<script>
  window.checkoutBuyer = 'https://fastrr-boost-ui.pickrr.com/';
</script>
<link rel="stylesheet" href="https://fastrr-boost-ui.pickrr.com/assets/styles/shopify.css">
<script src="https://fastrr-boost-ui.pickrr.com/assets/js/channels/shopify.js" defer></script>
<script src="https://fastrr-boost-ui.pickrr.com/assets/js/channels/shiprocketMarketing.js" defer></script>
<style>
  .sr-headless-checkout {
    font-family: inherit;
    color: #1f1f1f;
    font-size: 15px;
    font-weight: 600;
    border-radius: 10px;
    height: 60px;
    letter-spacing: 1px;
    background-color: #efb530;
  }
  .shiprocket-headless[data-type='mini-cart'] .sr-headless-checkout {
    color: #ffffff;
    border-radius: 99px;
    height: 49px;
    letter-spacing: 1px;
    background-color: #5e6f36;
  }
  .shiprocket-headless[data-type='cart'] .sr-headless-checkout {
    color: #ffffff;
    background-color: #5e6f36;
    font-size: 13px !important;
  }
  .shiprocket-headless[data-type='product'] .sr-powered-by,
  .shiprocket-headless[data-type='product'] .sr-checkout-visible1[alt='right_arrow'] {
    filter: grayscale(100%) brightness(0%);
  }
  .shiprocket-headless .sr-powered-by {
    right: 12px !important;
  }
  .shiprocket-headless {
    width: 100% !important;
  }
</style>
